{
  "expo": {
    "name": "Grdlabs",
    "slug": "grdlabs-mobile",
    "scheme": "grdlabs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#E9EDF5",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E9EDF5"
    },
    "ios": {
      "bundleIdentifier": "site.grdlabs.app",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:grdlabs.site"
      ],
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ar",
        "CFBundleAllowMixedLocalizations": true,
        "NSFaceIDUsageDescription": "نستخدم Face ID حتى نتأكد إنك صاحب الحساب قبل تسجيل الحضور.",
        "NSLocationWhenInUseUsageDescription": "نتأكد من موقعك وقت تسجيل الحضور حتى نعرف إنك داخل الشركة.",
        "NSCameraUsageDescription": "نستخدم الكاميرا حتى تمسح رمز الربط من برنامج الشركة.",
        "NFCReaderUsageDescription": "نقرأ ملصق الشركة حتى نسجل حضورك وانصرافك.",
        "ITSAppUsesNonExemptEncryption": false,
        "ExpoLocalization_forcesRTL": true
      }
    },
    "android": {
      "package": "site.grdlabs.app",
      "adaptiveIcon": {
        "backgroundColor": "#E9EDF5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.NFC",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.USE_FINGERPRINT"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "grdlabs.site",
              "pathPrefix": "/app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true,
      "eas": {
        "projectId": "857b208a-8c27-43a7-a4da-1e804efc98fe"
      }
    },
    "plugins": [
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "نستخدم الكاميرا حتى تمسح رمز الربط من برنامج الشركة.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "نتأكد من موقعك وقت تسجيل الحضور حتى نعرف إنك داخل الشركة."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "نستخدم Face ID حتى نتأكد إنك صاحب الحساب قبل تسجيل الحضور."
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "نقرأ ملصق الشركة حتى نسجل حضورك وانصرافك.",
          "includeNdefEntitlement": false
        }
      ],
      "expo-font",
      "expo-sharing"
    ],
    "owner": "grdlabs"
  }
}
